{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "bun",
    "schematicCollections": ["angular-eslint"],
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "electron": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css"
        }
      },
      "root": "projects/electron",
      "sourceRoot": "projects/electron/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/electron/src/main.ts",
            "tsConfig": "projects/electron/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/electron/public"
              }
            ],
            "styles": [
              "@fontsource/roboto/400.css",
              "@fontsource/roboto/500.css",
              "@fontsource/roboto/700.css",
              "material-icons/iconfont/material-icons.css",
              "projects/electron/src/theme.scss",
              "projects/electron/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "baseHref": "./",
              "optimization": {
                "styles": {
                  "inlineCritical": false
                }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "electron:build:production"
            },
            "development": {
              "buildTarget": "electron:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageInclude": ["projects/electron/src/app/**/*.ts"],
            "coverageExclude": ["projects/electron/src/app/**/*.spec.ts"],
            "coverageReporters": ["text", "html", "cobertura"],
            "coverageThresholds": {
              "statements": 80,
              "branches": 80,
              "functions": 80,
              "lines": 80
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "cache": true,
            "cacheLocation": ".angular/cache/eslint",
            "cacheStrategy": "content",
            "lintFilePatterns": ["projects/electron/**/*.ts", "projects/electron/**/*.html"],
            "eslintConfig": "projects/electron/eslint.config.js"
          }
        }
      }
    },
    "docs": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css"
        }
      },
      "root": "projects/docs",
      "sourceRoot": "projects/docs/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/docs/src/main.ts",
            "tsConfig": "projects/docs/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/electron/public"
              }
            ],
            "styles": [
              "@fontsource/roboto/400.css",
              "@fontsource/roboto/500.css",
              "@fontsource/roboto/700.css",
              "material-icons/iconfont/material-icons.css",
              "projects/electron/src/theme.scss",
              "projects/docs/src/styles.css"
            ],
            "server": "projects/docs/src/main.server.ts",
            "outputMode": "static",
            "security": {
              "allowedHosts": []
            },
            "ssr": {
              "entry": "projects/docs/src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "12kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "docs:build:production"
            },
            "development": {
              "buildTarget": "docs:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageInclude": ["projects/docs/src/app/**/*.ts"],
            "coverageExclude": ["projects/docs/src/app/**/*.spec.ts"],
            "coverageReporters": ["text", "html", "cobertura"],
            "coverageThresholds": {
              "statements": 80,
              "branches": 80,
              "functions": 80,
              "lines": 80
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "cache": true,
            "cacheLocation": ".angular/cache/eslint",
            "cacheStrategy": "content",
            "lintFilePatterns": ["projects/docs/**/*.ts", "projects/docs/**/*.html"],
            "eslintConfig": "projects/docs/eslint.config.js"
          }
        }
      }
    }
  }
}
